    "/create/{environment}": {
      "post": {
        "tags": [
          "Identities"
        ],
        "summary": "Create  Identity",
        "description": "Create an identity record, including optional additions as permitted for your credential:\n  - `obid` - Create an OrgBrandedID sign-in credential for the identity, inviting the user to set a password for it, e.g.:\n    ```\n    \"obid\": true\n    ```\n  - `quiet` - Suppress any user-facing emails that might be triggered as a result of account creation -  e.g., an OrgBrandedID account setup email\n    ```\n    \"quiet\": true\n    ```\n  - `attributeCollections` - Create one or more authorized types of attribute collections for the identity, e.g.:\n    ```\n    \"attributeCollections\": [\n        {\n            \"attributeCollectionAuthority\": \"alumni\",\n            \"uid\": \"al-12345\",\n            \"attributes\": {\n                \"alumniId\": [\n                    \"al-12345\"\n                ],\n                \"givenName\": [\n                    \"Alice\"\n                ],\n                \"sn\": [\n                    \"Arcus\"\n                ]\n            }\n        }\n    ]\n    ```\n  - `remoteCredentials` - Create one or more remote credentials for the identity, e.g.:\n    ```\n    \"remoteCredentials\": [\n        {\n            \"remoteCredentialAuthority\": \"https://shib.athena-institute.net/idp/shibboleth\",\n            \"uid\": \"hugohail123\"\n        }\n    ]\n    ```\n  - `customerUidGen` - Auto-generate an identifier with a format customized to your organization, e.g.:\n    ```\n    \"customerUidGen\": \"athenaCustomId\"\n    ```",
        "operationId": "create_identity_create__environment__post",
        "security": [
          {
            "HTTPBasic": []
          }
        ],
        "parameters": [
          {
            "name": "environment",
            "in": "path",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/IdentityEnvironment",
              "description": "identity environment"
            },
            "description": "identity environment"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/IdentityCreateInput",
                "examples": [
                  {
                    "mail": "aarcus@athena-institute.net",
                    "givenName": "Alice",
                    "sn": "Arcus",
                    "obid": false,
                    "quiet": false,
                    "allowDuplicateEmail": false
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/IdentityModel"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/json": {
                "example": {
                  "detail": "not authorized"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/json": {
                "examples": {
                  "Email Conflict": {
                    "value": {
                      "detail": "identity record(s) for email \"user@domain.edu\" already exist: c2a34150-8f43-4f52-9601-3e7518ef0f34"
                    }
                  },
                  "OBID Conflict": {
                    "value": {
                      "detail": "OBID Error: account for \"user@domain.edu\" exists and is linked to other identity records: c2a34150-8f43-4f52-9601-3e7518ef0f34"
                    }
                  },
                  "AttributeCollection Conflict": {
                    "value": {
                      "detail": "attribute collection for (authority = \"sorId\", uid = \"sorUid\") already exists for identity UID = \"60ebb104-e6de-481e-aeed-b9f53083d05b\""
                    }
                  }
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          },
          "500": {
            "description": "Internal Server Error",
            "content": {
              "application/json": {
                "example": {
                  "detail": "database error: ..."
                }
              }
            }
          }
        }
      }
    },
    "/modify/{cirrusUid}": {
