        "tags": [
          "Identities"
        ],
        "summary": "Modify  Identity",
        "description": "Modify core attributes of identity record.\n\nThe attributes that may be modified are:\n\n- `givenName`\n- `sn`\n- `mail`\n\nAny combination of these attributes may be provided; only provided attribute values will be updated. Attributes\nwith a value of `null` will be ignored (treated the same as omitting them).\n\nIf the `mail` attribute value is present on another identity in the same environment, a `409 Conflict` error will\nbe returned. If you wish to override this behavior, and allow duplicate email values, pass `true` for the boolean\nparameter, `allowDuplicateEmail`.\n\nThe updated identity record is returned upon success.",
        "operationId": "modify_identity_modify__cirrusUid__patch",
        "security": [
          {
            "HTTPBasic": []
          }
        ],
        "parameters": [
          {
            "name": "cirrusUid",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "`cirrusUid` of identity record",
